<!doctype html>
<meta charset="utf-8">
<title>{{ profile.name }} — CV</title>
<style>
  /* Geometry lifted from the Affinity original, in pt. */
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --ink:      #384347;
    --accent:   #008cff;
    --sidebar:  #21405c;
    --rule:     #c9ced1;
    --sb-rule:  #6d8399;
    --sb-w:     180pt;     /* sidebar width — it sits on the left */
    --gut:      26pt;      /* main column's gap from the sidebar edge */
    --pad-r:    33.4pt;    /* main column's right margin */
  }

  html, body { width: 595.92pt; height: 842.88pt; }
  body {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 7.6pt;
    color: var(--ink);
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
    position: relative;
  }

  /* ---------- main column ---------- */
  /* Vertical rhythm matches the original: line-heights are absolute pt so a
     line step is exactly line-height + margin-top, same as Affinity's leading. */
  .main {
    position: absolute; top: 0; left: var(--sb-w);
    width: calc(595.92pt - var(--sb-w));
    padding: 28.4pt var(--pad-r) 0 var(--gut);
  }

  h1 {
    font-family: Rubik, Arial, sans-serif;
    font-weight: 500;
    font-size: 17.8pt;
    line-height: 21pt;
    letter-spacing: -0.15pt;
  }
  .subtitle { font-size: 10.1pt; line-height: 12pt; color: var(--accent); margin-top: 4.3pt; }

  .contact { margin-top: 6.1pt; font-family: Rubik, Arial, sans-serif; font-size: 8.2pt; }
  .contact div { display: flex; gap: 10.5pt; align-items: center; line-height: 13.5pt; }
  .contact svg { width: 7.6pt; height: 7.6pt; fill: currentColor; flex: none; margin-right: -7pt; }

  h2 {
    font-family: Rubik, Arial, sans-serif;
    font-weight: 400;
    font-size: 10.1pt;
    line-height: 12pt;
    letter-spacing: .3pt;
    margin-top: 5.5pt;
    padding-bottom: 3.4pt;
    border-bottom: .6pt solid var(--rule);
  }

  .entry { margin-top: 9.1pt; page-break-inside: avoid; }
  h2 + .entry { margin-top: 7.4pt; }
  .entry .row { display: flex; justify-content: space-between; align-items: baseline; gap: 10pt; }
  .entry .role { font-family: Rubik, Arial, sans-serif; font-size: 9.5pt; line-height: 11.4pt; }
  .entry .row:has(.org) { margin-top: 3.8pt; }
  .entry .org  { font-family: Rubik, Arial, sans-serif; font-size: 8.9pt; line-height: 10.7pt; color: var(--accent); }
  .entry .org a { color: var(--accent); text-decoration: none; }
  .entry .meta { font-size: 7.6pt; white-space: nowrap; }
  .entry .loc  { font-size: 7.6pt; white-space: nowrap; font-weight: bold; }

  ul { list-style: none; margin-top: 3.7pt; }
  li { position: relative; padding-left: 19.1pt; line-height: 9.6pt; }
  li::before { content: "•"; position: absolute; left: 5pt; }

  .tech { line-height: 9.6pt; }
  .tech b { font-weight: bold; }

  /* ---------- sidebar ---------- */
  .side {
    position: absolute; top: 0; left: 0;
    width: var(--sb-w);
    height: 842.88pt;
    background: var(--sidebar);
    color: #fff;
    padding: 0 19pt;
  }
  .photo {
    width: 76pt; height: 76pt; border-radius: 50%;
    object-fit: cover; display: block;
    margin: 22pt auto 0;
    border: 1.4pt solid rgba(255,255,255,.55);
  }
  .side h2 {
    color: #fff;
    border-bottom-color: var(--sb-rule);
    margin-top: 14pt;
  }
  .side p { margin-top: 6.4pt; line-height: 9.6pt; }

  .lang { display: flex; align-items: center; justify-content: space-between; margin-top: 8.6pt; }
  .lang .name  { font-family: Rubik, Arial, sans-serif; font-size: 8.9pt; }
  .lang .level { font-size: 7.5pt; margin-left: auto; margin-right: 9pt; }
  .dots { display: flex; gap: 2.6pt; }
  .dots i { width: 4.4pt; height: 4.4pt; border-radius: 50%; background: #fff; display: block; }
  .dots i.off { background: rgba(255,255,255,.3); }

  .skills { margin-top: 7pt; line-height: 11.7pt; }
  /* Visibly secondary to SKILLS — it should not read as an equal claim. */
  .skills.familiar { color: rgba(255,255,255,.72); }
</style>

<div class="main">
  <h1>{{ profile.name | upper }}</h1>
  <div class="subtitle">{{ profile.title }}</div>

  <div class="contact">
    <div>
      <svg viewBox="0 0 24 24"><path d="M6.6 10.8a15 15 0 006.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 013 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2z"/></svg><span>{{ profile.phone }}</span>
      <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 100 20 10 10 0 001.6-.1v-1.8A8.2 8.2 0 1120.2 12v1.1c0 .8-.4 1.3-1 1.3s-1-.5-1-1.3V7.6h-1.7v.9A4 4 0 108 15.4a4 4 0 003.3-1.6 2.5 2.5 0 004.6-.6V12A10 10 0 0012 2zm0 12.3A2.3 2.3 0 1114.3 12 2.3 2.3 0 0112 14.3z"/></svg><span>{{ profile.email }}</span>
      <svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 00-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 00-7-7zm0 9.5A2.5 2.5 0 1114.5 9 2.5 2.5 0 0112 11.5z"/></svg><span>{{ profile.location }}</span>
    </div>
    <div>
      <svg viewBox="0 0 24 24"><path d="M12 .5a11.5 11.5 0 00-3.6 22.4c.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.1.1 1.7 1.2 1.7 1.2 1 1.8 2.7 1.3 3.4 1 .1-.7.4-1.2.7-1.5-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 015.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6A11.5 11.5 0 0012 .5z"/></svg><span>{{ profile.github }}</span>
      <svg viewBox="0 0 24 24"><path d="M20.4 0H3.5A3.5 3.5 0 000 3.5v17A3.5 3.5 0 003.5 24h17a3.5 3.5 0 003.5-3.5v-17A3.5 3.5 0 0020.4 0zM7.2 20.4H3.6V9h3.6v11.4zM5.4 7.4a2.1 2.1 0 110-4.2 2.1 2.1 0 010 4.2zm15 13H16.8v-5.6c0-1.3 0-3-1.9-3s-2.1 1.5-2.1 2.9v5.7H9.3V9h3.4v1.6h.1a3.8 3.8 0 013.4-1.9c3.6 0 4.3 2.4 4.3 5.5v6.2z"/></svg><span>{{ profile.linkedin }}</span>
    </div>
  </div>

  {% if experience %}
  <h2>EXPERIENCE</h2>
  {% for e in experience %}
  <div class="entry">
    <div class="row"><span class="role">{{ e.role }}</span><span class="meta">{{ e.dates }}</span></div>
    <div class="row"><span class="org">{{ e.org }}</span><span class="loc">{{ e.location }}</span></div>
    <ul>{% for b in e.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
    {% if e.tech %}<div class="tech"><b>Technologies Used:</b> {{ e.tech }}</div>{% endif %}
  </div>
  {% endfor %}
  {% endif %}

  {% if education %}
  <h2>EDUCATION</h2>
  {% for e in education %}
  <div class="entry">
    <div class="row"><span class="role">{{ e.degree }}</span><span class="meta">{{ e.dates }}</span></div>
    <div class="row"><span class="org">{{ e.org }}</span><span class="loc">{{ e.location }}</span></div>
  </div>
  {% endfor %}
  {% endif %}

  {% if projects %}
  <h2>PROJECTS</h2>
  {% for p in projects %}
  <div class="entry">
    <div class="row"><span class="role">{{ p.name }}</span><span class="meta">{{ p.dates }}</span></div>
    <div class="row">
      <span class="org">{{ p.subtitle }}{% if p.link %} – <a href="https://{{ p.link }}">{{ p.link }}</a>{% endif %}</span>
      <span class="loc">{{ p.location }}</span>
    </div>
    <ul>{% for b in p.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
    {% if p.tech %}<div class="tech"><b>Technologies used:</b> {{ p.tech }}</div>{% endif %}
  </div>
  {% endfor %}
  {% endif %}
</div>

<div class="side">
  {% if photo_uri %}<img class="photo" src="{{ photo_uri }}">{% endif %}

  <h2>ABOUT ME</h2>
  {% for a in about %}<p>{{ a.text }}</p>{% endfor %}

  {% if languages %}
  <h2>LANGUAGES</h2>
  {% for l in languages %}
  <div class="lang">
    <span class="name">{{ l.name }}</span><span class="level">{{ l.level }}</span>
    <span class="dots">{% for i in range(5) %}<i class="{{ '' if i < l.dots else 'off' }}"></i>{% endfor %}</span>
  </div>
  {% endfor %}
  {% endif %}

  {% if skills %}
  <h2>SKILLS</h2>
  <div class="skills">{{ skills | join(" • ") }}</div>
  {% endif %}

  {# Opt-in per posting. Labelled so the claim it makes is the true one. #}
  {% if familiar %}
  <h2>FAMILIAR</h2>
  <div class="skills familiar">{{ familiar | join(" • ") }}</div>
  {% endif %}
</div>
